{
  "expo": {
    "name": "Revert2Reality",
    "slug": "revert2reality",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#321D17",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.revert2reality"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Revert2Reality to calculate local prayer times and find the Qibla."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e80bd2e7-8406-4804-8ef0-1ffadb3c46da"
      }
    }
  }
}
